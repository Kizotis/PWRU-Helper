<Window x:Class="PWRUHelper.CompactOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PWRU Helper (compact)"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" WindowStartupLocation="Manual"
        ResizeMode="CanResize"
        Width="360" Height="440" MinWidth="240" MinHeight="180">

    <Border Background="#F2071C2F" CornerRadius="10"
            BorderBrush="{StaticResource GoldBrush}" BorderThickness="1">
        <Grid Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ===== Header (drag to move) =====
                 A DOCK PANEL, and it has to be one: this header used to be a single-cell Grid with
                 a left group and a right group overlapping in the same cell, which is fine only
                 while their widths happen to add up. They stopped adding up the day the chip
                 arrived — at the shipped 360 px with LIVE running, "● Google" painted over 40 of
                 the 45 px of "● LIVE", and at MinWidth 240 the buttons already sat on top of the
                 title before the chip existed.
                 Docking makes the header safe BY CONSTRUCTION and in a PRIORITY ORDER a Grid
                 cannot express: every child gets a rectangle of its own out of what is left, in
                 declaration order, so what runs out of room is decided here rather than by whose
                 turn it is to be painted last. Measured (TP-RENDER-09, both widths):
                   1. the buttons  — interactive, and a column layout pushed them off the window
                                     edge instead (⤢ ended at x=479 on a 240 px window);
                   2. ● LIVE       — R-02's promise that the loop is alive, 45 px, fixed;
                   3. the chip     — trims to an ellipsis, and its full state is one hover away
                                     and on the status line below;
                   4. the title    — decoration, and the only thing here the player already knows.
                 The two title Runs are one TextBlock now for exactly that reason: a StackPanel
                 does not clip, so its parts would have gone on painting outside their own slot. -->
            <DockPanel Grid.Row="0" x:Name="HeaderBar" Background="Transparent"
                       MouseLeftButtonDown="Header_MouseDown">
                <StackPanel x:Name="HeaderButtons" DockPanel.Dock="Right" Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Copy from the deck, not from here (A8): this button becomes the cancel while
                         a read is in flight — see MainWindow.SetReadOnceCancelMode. -->
                    <Button x:Name="ReadOnceButton" Style="{StaticResource GhostButton}" Padding="8,2"
                            Margin="0,0,6,0" Click="ReadOnce_Click"/>
                    <Button x:Name="LiveToggleButton" Style="{StaticResource GhostButton}" Padding="8,2"
                            Content="▶ Live" Click="LiveToggle_Click"
                            ToolTip="Start / stop live translation on your last area (Ctrl+Alt+L)"
                            AutomationProperties.Name="Start or stop live translation"/>
                    <Button Style="{StaticResource GhostButton}" Padding="8,2" Margin="6,0,0,0"
                            Content="⤢" Click="Expand_Click" ToolTip="Back to the full window"
                            AutomationProperties.Name="Back to the full window"/>
                </StackPanel>
                <TextBlock x:Name="LiveDot" DockPanel.Dock="Right" Text="  ●  LIVE"
                           Foreground="{StaticResource AccentBrush}" TextTrimming="CharacterEllipsis"
                           FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
                <!-- The provider chip, overlay placement: on the header line, right-hand end, beside
                     the buttons — the one always-on indicator (§2.2) on the window the player
                     actually looks at while the game is up. Text, foreground and tooltip are all
                     written from MainWindow.PaintEngineChip (SetEngineChip below): the main window
                     composes, this window renders (I2). MaxWidth 130 is the longest label the app
                     can produce (S8's "● Google (backup) · DeepL quota out", 127.9 px measured), so
                     a window with room shows the whole state and never a mystery ellipsis. -->
                <TextBlock x:Name="EngineChipText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           FontSize="11" MaxWidth="130" TextTrimming="CharacterEllipsis" Margin="8,0,8,0"
                           Foreground="{StaticResource TextMutedBrush}"
                           AutomationProperties.Name="Translation engine status"/>
                <TextBlock x:Name="TitleText" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"><Run Text="PWRU" FontWeight="Bold"
                           Foreground="{StaticResource AccentBrush}"/><Run Text=" Helper" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}"/></TextBlock>
            </DockPanel>

            <!-- ===== Live status line ===== -->
            <TextBlock x:Name="OverlayStatus" Grid.Row="1" TextWrapping="Wrap" FontSize="11"
                       Margin="0,4,0,0" Foreground="{StaticResource TextMutedBrush}" Visibility="Collapsed"/>

            <!-- ===== Live feed (shared with the main window) ===== -->
            <ScrollViewer x:Name="FeedScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          Margin="0,8,0,0" Padding="0,0,6,0">
                <StackPanel>
                    <TextBlock x:Name="EmptyHint" TextWrapping="Wrap" Foreground="{StaticResource TextMutedBrush}"
                               FontSize="12"
                               Text="Press ▶ Live to translate your chat here. Type below to send a Russian reply."/>
                    <ItemsControl x:Name="FeedItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Background/border live in the Style, NOT as attributes: a local value
                                     beats a style trigger in WPF, so the read-once frame would never win. -->
                                <Border CornerRadius="6" Padding="8,6" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
                                            <Setter Property="BorderThickness" Value="0"/>
                                            <Style.Triggers>
                                                <!-- "Read once" lands in the live feed rather than replacing it,
                                                     so frame it — this is the whole point of reading from the
                                                     overlay: spotting your one result among the live lines. -->
                                                <DataTrigger Binding="{Binding IsReadOnce}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{StaticResource TealBrush}"/>
                                                    <Setter Property="BorderThickness" Value="2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <!-- Two-tone like the main translator: grey speaker nick + body.
                                             Run.Text binds TwoWay by default, so read-only props need Mode=OneWay. -->
                                        <TextBlock FontSize="11" TextWrapping="Wrap"><Run Text="{Binding SpeakerPrefix, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}" FontWeight="SemiBold"/><Run Text="{Binding OriginalBody, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/></TextBlock>
                                        <TextBlock FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0"><Run Text="{Binding SpeakerPrefix, Mode=OneWay}" Foreground="{StaticResource TextMutedBrush}"/><Run Text="{Binding TranslationBody, Mode=OneWay}" Foreground="{StaticResource TextBrush}"/></TextBlock>
                                        <TextBlock Text="{Binding Glossary}" FontSize="11"
                                                   Foreground="{StaticResource GoldBrush}" TextWrapping="Wrap"
                                                   Margin="0,2,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <Trigger Property="Text" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== Quick reply ===== -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0">
                    <TextBox x:Name="ReplyBox" KeyDown="ReplyBox_KeyDown" TextChanged="ReplyBox_TextChanged"
                             VerticalContentAlignment="Center" Padding="6,4"/>
                    <TextBlock x:Name="ReplyPlaceholder" IsHitTestVisible="False"
                               Text="Type a reply → Enter (→ Russian, copied)"
                               VerticalAlignment="Center" Margin="8,0,0,0"
                               Foreground="{StaticResource TextMutedBrush}"/>
                </Grid>
                <TextBlock x:Name="ReplyResult" Grid.Row="1" TextWrapping="Wrap" Margin="2,4,0,0"
                           FontSize="12" Foreground="{StaticResource GoldBrush}"/>

                <!-- Long reply: split into game-sized blocks to copy & send one after another. -->
                <StackPanel x:Name="ReplyBlocksPanel" Grid.Row="2" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBlock x:Name="ReplyBlocksHint" TextWrapping="Wrap" FontSize="11" Margin="2,0,0,4"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Too long for one chat message — copy each block and send them in order:"/>
                    <ItemsControl x:Name="ReplyBlocks">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Label}" FontWeight="Bold"
                                               Foreground="{StaticResource GoldBrush}" VerticalAlignment="Center"
                                               Margin="0,0,6,0"/>
                                    <Border Grid.Column="1" Background="{StaticResource PanelBrush}" CornerRadius="6"
                                            Padding="8,5">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"/>
                                    </Border>
                                    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Padding="8,2"
                                            Margin="6,0,0,0" Content="Copy" Click="CopyBlock_Click"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
