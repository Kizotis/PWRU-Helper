<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Match the app's TFM so we can reference it; tests only touch pure, headless logic. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <!-- E4.S3 / U8 — the opt-in switch for the measurement harness (CacheLoadSpike.cs). MSBuild reads
       environment variables as properties, so `set PWRU_SPIKE=1` before `dotnet test` is the whole
       mechanism: with it, the harness's [Fact] attributes compile in and the Category=Spike filter
       runs them; without it CI discovers ZERO cases there and the suite count and its two seconds
       are untouched. A [Fact(Skip=…)] cannot do this — `Skip` is a compile-time constant no
       environment variable can lift, and the skipped cases would still be counted on every run. -->
  <PropertyGroup Condition="'$(PWRU_SPIKE)' == '1'">
    <DefineConstants>$(DefineConstants);PWRU_SPIKE</DefineConstants>
  </PropertyGroup>

  <!-- E8.S1 / U6-U7 — the ONE package ruling E8-d authorises, and only for the spike. It is on the
       TEST project (never on PWRUHelper.csproj: nothing here ships) and it hangs off the SAME
       PWRU_SPIKE variable as the define above, so a normal `dotnet test` restores exactly what it
       restored before and downloads nothing. `ExcludeAssets="native"` is the U7 experiment itself:
       the 21.4 MB `bergamot.dll` is kept OUT of the build output, and BergamotSpike satisfies the
       binding's [LibraryImport("bergamot")] from a downloaded directory via
       NativeLibrary.SetDllImportResolver. If that works, shipping this feature costs 0 MB of exe
       growth and leaves `%TEMP%\.net\PWRUHelper\<id>` at its five WPF files. The version is PINNED:
       every figure in benchmark-fournisseurs.md §6.2 and §10 was measured against 0.5.1. -->
  <ItemGroup Condition="'$(PWRU_SPIKE)' == '1'">
    <PackageReference Include="BergamotTranslatorSharp" Version="0.5.1" ExcludeAssets="native" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\PWRUHelper.csproj" />
  </ItemGroup>

  <!-- IS-9 — recorded HTTP bodies, checked in as source because they are evidence (CI-6: <= 64 KB
       total, nothing binary, nothing generated at test time). `Update`, not `Include`: the SDK's
       default None glob already picks these files up, and a second Include is a duplicate-item
       build error. Copied next to the test assembly so a test reads them with
       Path.Combine(AppContext.BaseDirectory, "Fixtures", ...) and a human can still open, diff and
       re-capture the file. Chosen over EmbeddedResource for exactly that reason — E3/E6 add their
       fixtures to this same group. -->
  <ItemGroup>
    <None Update="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
